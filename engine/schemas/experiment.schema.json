{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/RyanAhn533/claude-research-engine/schemas/experiment.schema.json",
  "title": "Experiment leaderboard row",
  "description": "One row per evaluated experiment. Append-only. Gate C uses paired-delta (external review §3 problem 4).",
  "type": "object",
  "required": [
    "exp_id",
    "iteration",
    "method",
    "method_id",
    "config_fingerprint",
    "timestamp",
    "constraints_passed",
    "stage",
    "manifest_ref"
  ],
  "properties": {
    "exp_id": {
      "type": "string",
      "pattern": "^exp_[0-9]{3,}_[a-z_0-9]+$"
    },
    "iteration": {"type": "integer", "minimum": 0},
    "method": {"type": "string", "minLength": 1},
    "method_id": {
      "type": "string",
      "pattern": "^[a-z][a-z_0-9]*$",
      "description": "Stable id for dedup. Different from human-readable method name."
    },
    "config_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Hash of (lr, bs, init, ...). Dedup is (method_id, config_fingerprint)."
    },
    "paper_ref": {"type": ["string", "null"]},
    "metric_name": {"type": "string"},
    "constraints_passed": {"type": "boolean"},
    "baseline_candidate": {"type": "boolean"},
    "timestamp": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"},
    "results": {
      "type": "object",
      "description": "Free-form result dict. Per-seed numbers, conditions, etc."
    },
    "stage": {
      "type": "string",
      "enum": ["prototype", "paper_ready"]
    },
    "n_seeds": {"type": "integer", "minimum": 1},
    "paired_delta_mean": {"type": ["number", "null"]},
    "paired_delta_ci_95": {
      "type": ["array", "null"],
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 2,
      "description": "Bootstrap 95% CI of paired delta (new - baseline). CI_lower > 0 is part of Gate C."
    },
    "cohen_d_paired": {"type": ["number", "null"]},
    "wilcoxon_p": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "tost_passed": {"type": ["boolean", "null"], "description": "DEPRECATED alias of practical_effect_passed. Kept for back-compat."},
    "practical_effect_passed": {"type": ["boolean", "null"], "description": "CI lower > 0 AND |mean delta| >= delta_threshold."},
    "tost_equivalent": {"type": ["boolean", "null"], "description": "True TOST: equivalence within ±delta_threshold band."},
    "tost_equivalent_p_lo": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "tost_equivalent_p_hi": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "gate_c_verdict": {
      "type": "string",
      "enum": ["improvement_candidate", "neutral", "failed", "pending"]
    },
    "gate_b_verdict": {
      "type": "string",
      "enum": ["pass", "repair_syntactic", "repair_semantic", "repair_dynamics", "protocol_violation", "pending"]
    },
    "linked_claims": {
      "type": "array",
      "items": {"type": "string", "pattern": "^C[0-9]+_[a-z_]+$"},
      "description": "Paper claim ids this exp supports/contradicts. Required for paper_ready stage."
    },
    "manifest_ref": {
      "type": "string",
      "description": "Path to reproducibility_manifest. Missing manifest blocks LOGGING."
    },
    "self_attack_run": {"type": "boolean"},
    "self_attack_concerns": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Auto-attached from SELF_ATTACK phase (advisory only)."
    },
    "supersedes": {"type": ["string", "null"]},
    "prev_hash": {"type": ["string", "null"]},
    "row_id": {"type": "string"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "paper_ready stage requires Gate C statistical fields and claim linkage",
      "if": {"properties": {"stage": {"const": "paper_ready"}}},
      "then": {
        "required": [
          "n_seeds",
          "paired_delta_ci_95",
          "cohen_d_paired",
          "wilcoxon_p",
          "linked_claims"
        ],
        "properties": {
          "n_seeds": {"minimum": 7}
        }
      }
    },
    {
      "description": "prototype stage requires at least 3 seeds",
      "if": {"properties": {"stage": {"const": "prototype"}}},
      "then": {
        "required": ["n_seeds"],
        "properties": {
          "n_seeds": {"minimum": 3}
        }
      }
    }
  ]
}
