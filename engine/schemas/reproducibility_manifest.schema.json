{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/RyanAhn533/claude-research-engine/schemas/reproducibility_manifest.schema.json",
  "title": "Reproducibility Manifest",
  "description": "One per experiment. Generated in Phase 3 IMPLEMENTATION before run.py. Missing manifest blocks LOGGING (METHODOLOGY §0.4).",
  "type": "object",
  "required": [
    "exp_id",
    "created_at",
    "git_sha",
    "data_hash",
    "env_lock",
    "random_state",
    "hardware"
  ],
  "properties": {
    "exp_id": {
      "type": "string",
      "pattern": "^exp_[0-9]{3,}_[a-z_0-9]+$"
    },
    "created_at": {"type": "string", "format": "date-time"},
    "git_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,40}$",
      "description": "Full or short git commit sha at experiment creation"
    },
    "git_dirty": {
      "type": "boolean",
      "description": "true if uncommitted changes exist. paper_ready stage requires false."
    },
    "data_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Hash of the exact data slice used (train/val/test indices, not raw files)"
    },
    "env_lock": {
      "type": "string",
      "description": "Path to poetry.lock / uv.lock / conda env export / pip freeze"
    },
    "env_lock_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "random_state": {
      "type": "object",
      "required": ["python", "numpy", "torch"],
      "properties": {
        "python": {"type": "integer"},
        "numpy": {"type": "integer"},
        "torch": {"type": "integer"},
        "cuda_deterministic": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "hardware": {
      "type": "object",
      "required": ["gpu"],
      "properties": {
        "gpu": {"type": "string", "description": "e.g. 'A6000 48GB'"},
        "driver": {"type": "string"},
        "cuda": {"type": "string"},
        "host": {"type": "string"}
      },
      "additionalProperties": false
    },
    "container_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "supersedes": {"type": ["string", "null"]},
    "prev_hash": {"type": ["string", "null"]},
    "row_id": {"type": "string"}
  },
  "additionalProperties": false
}
