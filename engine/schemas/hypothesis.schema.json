{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/RyanAhn533/claude-research-engine/schemas/hypothesis.schema.json",
  "title": "Pre-registered hypothesis",
  "description": "Written in Phase 1.5 HYPOTHESIS_REGISTRATION. Prevents post-hoc narrative shopping (ARCHITECTURE §6.1).",
  "type": "object",
  "required": [
    "hypothesis_id",
    "exp_id",
    "primary",
    "null_hypothesis",
    "success_criterion",
    "falsifiability_check",
    "registered_at"
  ],
  "properties": {
    "hypothesis_id": {
      "type": "string",
      "pattern": "^H_[a-z_0-9]+$"
    },
    "exp_id": {
      "type": "string",
      "pattern": "^exp_[0-9]{3,}_[a-z_0-9]+$"
    },
    "primary": {
      "type": "string",
      "minLength": 10,
      "description": "Falsifiable primary claim, e.g. 'NormWear lowers within_class_distance vs ResNet on K-EmoCon'"
    },
    "null_hypothesis": {
      "type": "string",
      "minLength": 5
    },
    "success_criterion": {
      "type": "object",
      "required": ["metric", "direction", "delta_threshold"],
      "properties": {
        "metric": {"type": "string"},
        "direction": {
          "type": "string",
          "enum": ["lower_is_better", "higher_is_better"]
        },
        "delta_threshold": {
          "type": "number",
          "description": "TOST equivalence margin. Pre-registered, never changed mid-iteration."
        }
      },
      "additionalProperties": false
    },
    "failure_implication": {
      "type": "string",
      "description": "What the null result means for the broader narrative."
    },
    "falsifiability_check": {
      "type": "string",
      "enum": ["PASS", "FAIL"],
      "description": "Computed automatically. FAIL blocks the candidate from HUMAN_APPROVAL."
    },
    "registered_at": {"type": "string", "format": "date-time"},
    "outcome": {
      "type": ["object", "null"],
      "properties": {
        "result": {
          "type": "string",
          "enum": ["supported", "rejected", "neutral", "pending"]
        },
        "observed_delta": {"type": ["number", "null"]},
        "tost_passed": {"type": ["boolean", "null"], "description": "DEPRECATED alias of practical_effect_passed."},
        "practical_effect_passed": {"type": ["boolean", "null"]},
        "tost_equivalent": {"type": ["boolean", "null"]},
        "scored_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    },
    "linked_claim": {
      "type": ["string", "null"],
      "pattern": "^C[0-9]+_[a-z_]+$"
    },
    "supersedes": {"type": ["string", "null"]},
    "prev_hash": {"type": ["string", "null"]},
    "row_id": {"type": "string"}
  },
  "additionalProperties": false
}
